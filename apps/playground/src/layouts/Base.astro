---
import "@fontsource/hanken-grotesk/latin.css";
import "../assets/global.css";

interface NavigationItem {
    title: string;
    href: string;
}

interface NavigationGroup {
    title?: string;
    items: NavigationItem[];
}

interface Navigation {
    groups: NavigationGroup[];
}

// BASE_URL is "/" or "/repo" depending on the build base, so normalize the trailing slash once.
const base = import.meta.env.BASE_URL.endsWith("/")
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;

const withBase = (path: string) => `${base}${path}`;

const navigation: Navigation = {
    groups: [
        {
            title: "Demos",
            items: [
                { title: "Basic Editor", href: withBase("demos/default") },
                { title: "Read-only", href: withBase("demos/read-only") },
                { title: "HTML Content", href: withBase("demos/html") },
                { title: "Code Blocks", href: withBase("demos/code") },
                { title: "Frontmatter", href: withBase("demos/frontmatter") },
                { title: "Wiki links", href: withBase("demos/wiki-links") },
                { title: "Collaboration", href: withBase("demos/collaboration") },
                { title: "React", href: withBase("demos/react") },
            ],
        },
        {
            title: "Examples",
            items: [
                { title: "AI Chat", href: withBase("examples/ai-chat") },
                { title: "New Issue", href: withBase("examples/issue") },
            ],
        },
    ],
};
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
        <link rel="icon" href={withBase("favicon.ico")} />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>inksane Playground</title>
    </head>
    <body>
        <div class="h-dvh w-full max-w-full overflow-hidden flex">
            <div class="w-56 border-r bg-background flex-none p-6">
                <a href={base}>inksane</a>
                {
                    navigation.groups.map((group) => (
                        <div class="mt-6">
                            {group.title && (
                                <h2 class="mb-2 text-sm font-semibold">
                                    {group.title}
                                </h2>
                            )}
                            <ul>
                                {group.items.map((item) => (
                                    <li>
                                        <a
                                            href={item.href}
                                            class="block rounded-md px-3 py-2 text-sm hover:bg-accent hover:text-accent-foreground"
                                        >
                                            {item.title}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
            <div class="min-h-0 min-w-0 flex-1 overflow-x-hidden overflow-y-auto p-6 lg:p-16">
                <div class="max-w-4xl mx-auto">
                    <slot />
                </div>
            </div>
        </div>
    </body>
</html>
