---
import Base from "../../../layouts/Base.astro";

import { rawContent } from '../../../../../../README.md'
const markdown = rawContent()
---

<Base>
    <div class="mb-4 flex items-center gap-2 flex-wrap">
        <button data-action="toggleBold">Toggle Bold</button>
        <button data-action="toggleItalic">Toggle Italic</button>
    </div>
    <div id="editor-mount" class="border" data-markdown={markdown}></div>
</Base>

<script>
    import { Editor, type Extension } from "@inksane/core";
    import { EditorView } from "@codemirror/view";

    const buttons = document.querySelectorAll("button[data-action]");

    const TestExtension: Extension = {
        name: "test",
        priority: 10,
        addKeybinds() {
            return [
                {
                    key: "Mod-Enter",
                    run(view) {
                        const newContent = `Hello World!\n\n**This** is a great text _extension_!`;
                        // insert "Hello World" at the current cursor position
                        view.dispatch({
                            changes: {
                                from: view.state.selection.main.from,
                                to: view.state.selection.main.to,
                                insert: newContent,
                            },
                            selection: {
                                anchor:
                                    view.state.selection.main.from +
                                    newContent.length,
                            },
                        });
                        return true;
                    },
                },
            ];
        },
    };

    const theme = EditorView.theme({
        ".cm-content": { paddingTop: "24px", paddingBottom: "24px", caretColor: "white" },
        ".cm-line": { paddingLeft: "24px", paddingRight: "24px" },
    });

    const el = document.getElementById("editor-mount")!
    const markdown = el.dataset.markdown || "";

    const editor = new Editor({
        element: document.getElementById("editor-mount")!,
        content: markdown,
        lineWrapping: true,

        extensions: [TestExtension],
        theme,
        classNames: {
            editable: "font-sans",
        },
    });

    buttons.forEach(btn => {
      const action = (btn as HTMLButtonElement).dataset.action;

      btn.addEventListener("click", () => {
        switch(action) {
          case "toggleBold":
            editor.chain().toggleBold().focus().run();
            break;
          case "toggleItalic":
            editor.chain().toggleItalic().focus().run();
            break;
          default:
            console.warn(`No action defined for ${action}`);
        }
      });
    })

    console.log(editor);
    // @ts-expect-error we set the editor on window
    window.editor = editor;
</script>
