{
  "name": "@inksane/core",
  "version": "0.7.0",
  "description": "A modular and extensible Markdown editor built with CodeMirror 6.",
  "keywords": [
    "codemirror",
    "codemirror-6",
    "codemirror-6-editor",
    "codemirror-6-markdown",
    "codemirror-6-markdown-editor",
    "codemirror6",
    "editor",
    "extendable",
    "extensible",
    "extension-based",
    "extensions",
    "headless",
    "inksane",
    "markdown",
    "modular",
    "plugin",
    "plugin-based",
    "plugin-driven",
    "rich-text",
    "rich-text-editor",
    "rich-text-markdown",
    "rich-text-markdown-editor"
  ],
  "homepage": "https://github.com/bdbch/inksane#readme",
  "bugs": {
    "url": "https://github.com/bdbch/inksane/issues"
  },
  "license": "MIT",
  "author": "bdbch <git@bdbch.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bdbch/inksane"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./extensions/base-kit": "./dist/extensions/base-kit.mjs",
    "./extensions/blockquote": "./dist/extensions/blockquote.mjs",
    "./extensions/bold": "./dist/extensions/bold.mjs",
    "./extensions/code": "./dist/extensions/code.mjs",
    "./extensions/footnotes": "./dist/extensions/footnotes.mjs",
    "./extensions/frontmatter": "./dist/extensions/frontmatter.mjs",
    "./extensions/heading": "./dist/extensions/heading.mjs",
    "./extensions/highlight": "./dist/extensions/highlight.mjs",
    "./extensions/history": "./dist/extensions/history.mjs",
    "./extensions/horizontal-rule": "./dist/extensions/horizontal-rule.mjs",
    "./extensions/html": "./dist/extensions/html.mjs",
    "./extensions/image": "./dist/extensions/image.mjs",
    "./extensions/italic": "./dist/extensions/italic.mjs",
    "./extensions/keybinds": "./dist/extensions/keybinds.mjs",
    "./extensions/link": "./dist/extensions/link.mjs",
    "./extensions/list": "./dist/extensions/list.mjs",
    "./extensions/placeholder": "./dist/extensions/placeholder.mjs",
    "./extensions/strikethrough": "./dist/extensions/strikethrough.mjs",
    "./extensions/subscript": "./dist/extensions/subscript.mjs",
    "./extensions/superscript": "./dist/extensions/superscript.mjs",
    "./extensions/task-list": "./dist/extensions/task-list.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:exports": "vp pack && node scripts/checkExports.mjs",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@codemirror/commands": "catalog:",
    "@codemirror/lang-cpp": "catalog:",
    "@codemirror/lang-css": "catalog:",
    "@codemirror/lang-go": "catalog:",
    "@codemirror/lang-html": "catalog:",
    "@codemirror/lang-java": "catalog:",
    "@codemirror/lang-javascript": "catalog:",
    "@codemirror/lang-json": "catalog:",
    "@codemirror/lang-markdown": "catalog:",
    "@codemirror/lang-php": "catalog:",
    "@codemirror/lang-python": "catalog:",
    "@codemirror/lang-rust": "catalog:",
    "@codemirror/lang-sql": "catalog:",
    "@codemirror/lang-xml": "catalog:",
    "@codemirror/lang-yaml": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/legacy-modes": "catalog:",
    "@codemirror/search": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@lezer/common": "catalog:",
    "@lezer/highlight": "catalog:",
    "@lezer/markdown": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "jsdom": "catalog:",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
