{
  "name": "@inksane/core",
  "version": "0.0.0",
  "description": "A modular and extensible Markdown editor built with CodeMirror 6.",
  "homepage": "https://github.com/bdbch/inksane#readme",
  "bugs": {
    "url": "https://github.com/bdbch/inksane/issues"
  },
  "license": "MIT",
